/* File properties (Details tab) for dinput8.dll, or VDPatch.exe when compiled with /d PATCHER. */
#include <winver.h>
#include "version.h"

#ifdef PATCHER
#define FILE_DESC MOD_NAME " - 4 GB memory flag patcher for VD_BHIKKHUNI.exe"
#define FILE_NAME "VDPatch.exe"
#define FILE_TYPE VFT_APP
#else
#define FILE_DESC MOD_NAME " - fixes and options for " MOD_GAME
#define FILE_NAME "dinput8.dll"
#define FILE_TYPE VFT_DLL
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MOD_VER
 PRODUCTVERSION MOD_VER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE FILE_TYPE
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", MOD_NAME
            VALUE "ProductVersion", MOD_VER_STR
            VALUE "FileDescription", FILE_DESC
            VALUE "FileVersion", MOD_VER_STR
            VALUE "CompanyName", MOD_AUTHOR
            VALUE "LegalCopyright", "(c) " MOD_YEAR " " MOD_AUTHOR ". Free to use, see README."
            VALUE "Comments", MOD_NOTICE
            VALUE "InternalName", FILE_NAME
            VALUE "OriginalFilename", FILE_NAME
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
